    "puppeteer": "^21.6.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.10.0",
    "@types/puppeteer": "^7.0.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}