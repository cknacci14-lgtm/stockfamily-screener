<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Backtest Quiet</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  body{background:#0a0e1a;color:#cbd5e1;font-family:'JetBrains Mono',monospace}
  .card{background:#111827;border:1px solid #1f2937}
  .positive{color:#10b981}.negative{color:#ef4444}
  input[type="date"]::-webkit-calendar-picker-indicator{filter:invert(0.6);cursor:pointer}
  .filterBtn{transition:all .15s}
  .filterBtn.active{background:#10b981;color:#000;border-color:#10b981;font-weight:700}
</style>
</head>
<body class="p-4">
<div class="max-w-[1700px] mx-auto">
  <h1 class="text-lg font-bold text-white mb-3">âš¡ Backtest Quiet Before Storm</h1>

  <div class="card rounded-xl p-4 mb-4 flex flex-wrap gap-4 items-center">
    <div>
      <label class="text-[10px] text-emerald-400 block mb-1 font-bold tracking-widest">PILIH TANGGAL - KLIKABLE</label>
      <input id="dateInput" type="date" class="bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-white min-w-[180px]">
    </div>
    <button id="runBtn" class="px-6 py-2.5 bg-emerald-500 text-black font-bold rounded-lg text-sm">â–¶ RUN</button>
    <button id="reloadBtn" class="px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-lg text-sm">â†» Reload DB</button>
    <span id="dbInfo" class="text-[11px] text-slate-500 ml-2"></span>
    <div class="ml-auto flex gap-5 text-xs bg-slate-900/50 border border-slate-800 rounded-lg px-4 py-2">
      <div>H0:<b id="avg0" class="ml-1">-</b></div>
      <div>H+1:<b id="avg1" class="ml-1">-</b></div>
      <div>H+2:<b id="avg2" class="ml-1">-</b></div>
      <div>H+3:<b id="avg3" class="ml-1">-</b></div>
      <div>Winrate:<b id="winrate" class="ml-1 text-emerald-400">-</b></div>
    </div>
  </div>

  <div class="card rounded-xl overflow-hidden">
    <div class="p-3 border-b border-slate-800 flex flex-wrap justify-between items-center gap-3">
      <span id="liveLabel" class="text-xs text-emerald-400 font-bold">-</span>
      <div id="filterBar" class="flex gap-2 text-[11px]">
        <button class="filterBtn active px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800" data-filter="ALL">Semua</button>
        <button class="filterBtn px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800" data-filter="MELEDAK">ðŸš€ Meledak</button>
        <button class="filterBtn px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800" data-filter="TP">âœ… TP</button>
        <button class="filterBtn px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800" data-filter="NAIK">ðŸ“ˆ Naik</button>
        <button class="filterBtn px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800" data-filter="GAGAL">âŒ Gagal</button>
      </div>
      <span id="lastSync" class="text-[10px] text-slate-500"></span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-[11px]">
        <thead class="bg-slate-900/80 text-slate-400">
          <tr>
            <th class="p-2 text-left">#</th>
            <th class="p-2 text-left">SYM</th>
            <th class="p-2 text-left">DATE</th>
            <th class="p-2 text-right">CLOSE</th>
            <th class="p-2 text-right">SCORE</th>
            <th class="p-2 text-left">REASONS</th>
            <th class="p-2 text-right bg-slate-800/50">H0</th>
            <th class="p-2 text-right bg-emerald-950/30">H+1</th>
            <th class="p-2 text-right bg-emerald-950/30">H+2</th>
            <th class="p-2 text-right bg-emerald-950/30">H+3</th>
            <th class="p-2 text-right bg-amber-950/30">MAX</th>
            <th class="p-2 text-left">RESULT</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
const dateInput=document.getElementById('dateInput');
const runBtn=document.getElementById('runBtn');
const tbody=document.getElementById('tbody');
const filterBar=document.getElementById('filterBar');
let availableDates=[];
let lastDate=null;
let lastResults=[]; // hasil mentah dari API, disimpan supaya filter tidak perlu fetch ulang
let activeFilter='ALL';

function fmtPct(v){ if(v==null||isNaN(v)) return '-'; const sign=v>0?'+':''; return sign+v.toFixed(2)+'%'; }
function cls(v){ if(v==null) return 'text-slate-500'; return v>0?'positive':v<0?'negative':'text-slate-500'; }

// status key dipakai untuk filter; label dipakai untuk tampilan
function statusOf(r){
  if(r.max3_pct>5) return {key:'MELEDAK', label:'ðŸš€ MELEDAK'};
  if(r.max3_pct>3) return {key:'TP', label:'âœ… TP'};
  if(r.max3_pct>0) return {key:'NAIK', label:'ðŸ“ˆ Naik'};
  return {key:'GAGAL', label:'âŒ Gagal'};
}

async function loadDates(){
  const res=await fetch('/api/backtest/dates?t='+Date.now());
  const j=await res.json();
  availableDates=(j.dates||j||[]).sort();
  if(availableDates.length){
    const latest=availableDates[availableDates.length-1];
    dateInput.min=availableDates[0];
    dateInput.max=latest;
    dateInput.value=latest;
    document.getElementById('dbInfo').innerText=`DB ${availableDates.length} hari, ${availableDates[0]} â†’ ${latest}`;
  }
}
function findNearest(d){ if(availableDates.includes(d)) return d; return availableDates.filter(x=>x<=d).pop()||availableDates[0]; }

function renderRows(){
  const filtered = activeFilter==='ALL' ? lastResults : lastResults.filter(r=> statusOf(r).key===activeFilter);
  document.getElementById('liveLabel').innerText=`LIVE: ${filtered.length}/${lastResults.length} saham (filter: ${activeFilter==='ALL'?'Semua':activeFilter}) di ${lastDate}`;

  if(filtered.length===0){
    tbody.innerHTML=`<tr><td colspan="12" class="p-8 text-center">0 saham cocok filter ini</td></tr>`;
    return;
  }

  let html='';
  filtered.forEach((r,i)=>{
    const sym=r.code||r.symbol;
    const close=r.close||0;
    const score=r.quietScore!=null?r.quietScore.toFixed(1):(r.score!=null?r.score.toFixed(1):(r.max3_pct!=null?r.max3_pct.toFixed(1):'-'));
    const reasons=r.reasons?(Array.isArray(r.reasons)?r.reasons.join(', '):r.reasons):`Vol ${(r.volume/(r.avgVol20||1)*100).toFixed(0)}% avg`;
    const d0=r.changePct!=null?r.changePct:(r.d0_pct||0);
    const st=statusOf(r);
    html+=`<tr class="border-b border-slate-800/50 hover:bg-slate-800/40">
      <td class="p-2 text-slate-500">${i+1}</td>
      <td class="p-2 font-bold text-white">${sym}</td>
      <td class="p-2 text-slate-400">${r.date||lastDate}</td>
      <td class="p-2 text-right">${close.toLocaleString()}</td>
      <td class="p-2 text-right text-emerald-400 font-bold">${score}</td>
      <td class="p-2 text-[10px] max-w-[180px] truncate" title="${reasons}">${reasons}</td>
      <td class="p-2 text-right bg-slate-800/30 ${cls(d0)} font-bold">${fmtPct(d0)}</td>
      <td class="p-2 text-right bg-emerald-950/20 ${cls(r.d1_pct)}">${fmtPct(r.d1_pct)}</td>
      <td class="p-2 text-right bg-emerald-950/20 ${cls(r.d2_pct)}">${fmtPct(r.d2_pct)}</td>
      <td class="p-2 text-right bg-emerald-950/20 ${cls(r.d3_pct)}">${fmtPct(r.d3_pct)}</td>
      <td class="p-2 text-right bg-amber-950/20 font-bold ${cls(r.max3_pct)}">${fmtPct(r.max3_pct)}</td>
      <td class="p-2">${st.label}</td>
    </tr>`;
  });
  tbody.innerHTML=html;
}

filterBar.addEventListener('click', (e)=>{
  const btn=e.target.closest('.filterBtn');
  if(!btn) return;
  activeFilter=btn.dataset.filter;
  [...filterBar.querySelectorAll('.filterBtn')].forEach(b=> b.classList.toggle('active', b===btn));
  renderRows();
});

async function doBacktest(){
  let date=findNearest(dateInput.value);
  dateInput.value=date;
  runBtn.disabled=true; runBtn.innerText='â³';
  tbody.innerHTML='<tr><td colspan="12" class="p-8 text-center text-emerald-400">Loading...</td></tr>';
  try{
    const res=await fetch(`/api/backtest?date=${date}&t=${Date.now()}`);
    const j=await res.json();
    lastResults=j.results||[];
    lastDate=j.date||date;
    const stats=j.stats||{};
    const avg0 = lastResults.length? lastResults.reduce((a,b)=>a+(b.changePct||b.d0_pct||0),0)/lastResults.length : 0;
    document.getElementById('avg0').innerText=fmtPct(avg0);
    document.getElementById('avg1').innerText=fmtPct(stats.avg1);
    document.getElementById('avg2').innerText=fmtPct(stats.avg2);
    document.getElementById('avg3').innerText=fmtPct(stats.avg3);
    document.getElementById('winrate').innerText=(stats.winrate||0).toFixed(1)+'%';

    // reset filter ke "Semua" tiap kali RUN baru
    activeFilter='ALL';
    [...filterBar.querySelectorAll('.filterBtn')].forEach(b=> b.classList.toggle('active', b.dataset.filter==='ALL'));

    renderRows();
  }catch(e){ tbody.innerHTML=`<tr><td colspan="12" class="p-8 text-center text-red-400">${e.message}</td></tr>`; }
  finally{ runBtn.disabled=false; runBtn.innerText='â–¶ RUN'; }
}
dateInput.addEventListener('change',doBacktest);
runBtn.addEventListener('click',doBacktest);
document.getElementById('reloadBtn').addEventListener('click',loadDates);
window.addEventListener('load', async()=>{ await loadDates(); doBacktest(); });
</script>
<script src="/assets/stockfamily-sidebar.js"></script>
</body>
</html>

