<script>
  // ============================================================
  // CONFIG
  // ============================================================
  const DEFAULT_WATCHLIST = ["BBCA", "BBRI", "TLKM", "CUAN", "ASII", "GOTO", "KIJA", "SCMA"];
  const WATCHLIST_STORAGE_KEY = 'chartnalist_watchlist_codes';

  function loadWatchlistCodesFromStorage() {
    try {
      const raw = localStorage.getItem(WATCHLIST_STORAGE_KEY);
      if (raw) {
        const arr = JSON.parse(raw);
        if (Array.isArray(arr)) return arr;
      }
    } catch (_) {}
    return [...DEFAULT_WATCHLIST];
  }

  function saveWatchlistCodesToStorage() {
    try { localStorage.setItem(WATCHLIST_STORAGE_KEY, JSON.stringify(watchlistCodes)); } catch (_) {}
  }

  let watchlistCodes = loadWatchlistCodesFromStorage();
  let activeCode = "BBCA";
  let latestCandles = [];

  // ============================================================
  // FETCH HELPERS
  // ============================================================
  function fetchWithTimeout(url, ms = 8000) {
    const controller = new AbortController();
    const t = setTimeout(() => controller.abort(), ms);
    return fetch(url, { signal: controller.signal }).finally(() => clearTimeout(t));
  }

  async function apiGet(url) {
    const res = await fetchWithTimeout(url, 8000);
    if (!res.ok) {
      let msg = `HTTP ${res.status}`;
      try { const body = await res.json(); if (body?.error) msg = body.error; } catch (_) {}
      throw new Error(msg);
    }
    return res.json();
  }

  async function yahooQuoteBatch(symbols) {
    if (!symbols.length) return [];
    try {
      const data = await apiGet(`/api/yahoo/quote?symbols=${encodeURIComponent(symbols.join(','))}`);
      return data.success ? data.result : [];
    } catch (err) {
      console.error('[yahooQuoteBatch]', err);
      return [];
    }
  }

  async function yahooChart(symbol) {
    try {
      const data = await apiGet(`/api/yahoo/chart/${encodeURIComponent(symbol)}?range=1y&interval=1d`);
      if (!data.success || !data.result) return null;

      const result = data.result;
      const timestamps = result.timestamp || [];
      const quote = result.indicators?.quote?.[0] || {};
      const candles = [], volumes = [];

      for (let i = 0; i < timestamps.length; i++) {
        const o = quote.open?.[i], c = quote.close?.[i];
        if (o == null || c == null) continue;
        candles.push({ time: timestamps[i], open: o, high: quote.high?.[i], low: quote.low?.[i], close: c });
        volumes.push({
          time: timestamps[i],
          value: quote.volume?.[i] || 0,
          color: c >= o ? 'rgba(0, 230, 118, 0.45)' : 'rgba(255, 82, 82, 0.45)'
        });
      }
      return { candles, volumes, meta: result.meta || {} };
    } catch (err) {
      console.error('[yahooChart]', symbol, err);
      return null;
    }
  }

  function toCode(symbol) { return String(symbol || '').replace('.JK', '').toUpperCase(); }
  function toSymbol(code) { return `${String(code || '').trim().toUpperCase()}.JK`; }

  // ============================================================
  // FORMAT HELPERS
  // ============================================================
  const fmtRp = n => n == null ? '--' : `Rp ${Number(n).toLocaleString('id-ID')}`;
  const fmtNum = n => n == null ? '--' : Number(n).toLocaleString('id-ID');
  const fmtPct = n => n == null ? '--' : `${n >= 0 ? '+' : ''}${n.toFixed(2)}%`;

  // ============================================================
  // CHART INIT
  // ============================================================
  const chartContainer = document.getElementById('tvChart');
  const chart = LightweightCharts.createChart(chartContainer, {
    layout: { background: { type: 'solid', color: '#0B0E14' }, textColor: '#94a3b8' },
    grid: { vertLines: { color: '#1E222D' }, horzLines: { color: '#1E222D' } },
    rightPriceScale: { borderColor: '#2A2E39', autoScale: true },
    timeScale: { borderColor: '#2A2E39', timeVisible: false }
  });

  const candleSeries = chart.addCandlestickSeries({
    upColor: '#00E676', downColor: '#FF5252', borderVisible: false,
    wickUpColor: '#00E676', wickDownColor: '#FF5252'
  });

  const volumeSeries = chart.addHistogramSeries({
    priceFormat: { type: 'volume' },
    priceScaleId: 'volume_scale',
    priceLineVisible: false,
    lastValueVisible: false,
    overlay: true,
    base: 0
  });

  chart.priceScale('volume_scale').applyOptions({
    scaleMargins: {
      top: 0.8,
      bottom: 0
    }
  });

  const vwapSeries = chart.addLineSeries({ color: '#FFB300', lineWidth: 2, priceLineVisible: false, lastValueVisible: true });
  const gemSeries = chart.addLineSeries({
    color: '#A855F7',
    lineWidth: 2,
    priceScaleId: 'gem_scale',
    priceLineVisible: false,
    lastValueVisible: true,
    title: 'GEM'
  });
  // Level seperti RSI
  gemSeries.createPriceLine({ price: 75, color: '#00E676', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: '75' });
  gemSeries.createPriceLine({ price: 60, color: '#00E5FF', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: '60' });
  gemSeries.createPriceLine({ price: 45, color: '#FFB300', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: '45' });
  gemSeries.createPriceLine({ price: 30, color: '#FF5252', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: '30' });
  chart.priceScale('gem_scale').applyOptions({
    scaleMargins: { top: 0.85, bottom: 0 },
    borderVisible: false,
  });
  chart.priceScale('volume_scale').applyOptions({
    scaleMargins: { top: 0.7, bottom: 0.18 },
  });

  new ResizeObserver(entries => {
    if (!entries.length) return;
    const { width, height } = entries[0].contentRect;
    chart.applyOptions({ width, height });
  }).observe(chartContainer);

  // ============================================================
  // DATA CLEANING
  // ============================================================
  function cleanTimeSeries(items) {
    const map = new Map();
    for (const item of items) {
      if (!item || item.time == null) continue;
      map.set(item.time, item);
    }
    return [...map.values()].sort((a, b) => Number(a.time) - Number(b.time));
  }

  // ============================================================
  // INDICATOR MATH
  // ============================================================
  function calcRSI(candles, period = 14) {
    if (candles.length < period + 1) return null;
    let gains = 0, losses = 0;
    for (let i = candles.length - period; i < candles.length; i++) {
      const diff = candles[i].close - candles[i - 1].close;
      if (diff >= 0) gains += diff; else losses -= diff;
    }
    if (gains + losses === 0) return 50;
    const rs = gains / (losses || 1e-9);
    return 100 - (100 / (1 + rs));
  }

  function calcAnchoredVWAP(candles, volumeByTime) {
    let cumPV = 0, cumVol = 0;
    const out = [];
    for (const c of candles) {
      const vol = volumeByTime.get(c.time) || 0;
      const typical = (c.high + c.close + c.low) / 3;
      cumPV += typical * vol;
      cumVol += vol;
      out.push({ time: c.time, value: cumVol > 0 ? cumPV / cumVol : c.close });
    }
    return out;
  }

  function calcMarketStructure(candles) {
    if (candles.length < 7) return null;
    const swingHighs = [], swingLows = [];
    for (let i = 2; i < candles.length - 2; i++) {
      const c = candles[i];
      const isHigh = c.high > candles[i-1].high && c.high > candles[i-2].high &&
                     c.high > candles[i+1].high && c.high > candles[i+2].high;
      const isLow = c.low < candles[i-1].low && c.low < candles[i-2].low &&
                    c.low < candles[i+1].low && c.low < candles[i+2].low;
      if (isHigh) swingHighs.push(c.high);
      if (isLow) swingLows.push(c.low);
    }
    const lastHigh = swingHighs.length ? swingHighs[swingHighs.length - 1] : null;
    const prevHigh = swingHighs.length > 1 ? swingHighs[swingHighs.length - 2] : null;
    const lastLow = swingLows.length ? swingLows[swingLows.length - 1] : null;
    const prevLow = swingLows.length > 1 ? swingLows[swingLows.length - 2] : null;

    let trend = 'SIDEWAYS';
    if (lastHigh && prevHigh && lastLow && prevLow) {
      if (lastHigh > prevHigh && lastLow > prevLow) trend = 'BULLISH (HH/HL)';
      else if (lastHigh < prevHigh && lastLow < prevLow) trend = 'BEARISH (LH/LL)';
    }
    return { trend, lastHigh, lastLow };
  }

  // ============================================================
  // DATA STATUS BADGE
  // ============================================================
  function setDataStatus(text, tone) {
    const dot = document.getElementById('dataStatusDot');
    const label = document.getElementById('dataStatusLabel');
    const colors = {
      busy: ['bg-idx-amber', 'text-idx-amber'],
      ok: ['bg-idx-green', 'text-idx-green'],
      error: ['bg-idx-red', 'text-idx-red']
    };
    const [dotClass, textClass] = colors[tone] || colors.busy;
    dot.className = `w-2 h-2 rounded-full live-dot ${dotClass}`;
    label.className = `font-semibold ${textClass}`;
    label.innerText = text;
  }

  // ============================================================
  // LOAD HISTORY
  // ============================================================
  
  async function loadGemHistory(code) {
    try {
      const res = await fetch('/api/gem-score/history/' + encodeURIComponent(code));
      const json = await res.json();
      if (!json.success || !json.data || !json.data.length) {
        gemSeries.setData([]);
        return;
      }
      const gemData = json.data
        .filter(d => d.gem_score != null && d.trade_date)
        .map(d => {
          const t = Math.floor(new Date(d.trade_date + 'T00:00:00+07:00').getTime() / 1000);
          return { time: t, value: d.gem_score };
        })
        .filter(d => !isNaN(d.time));
      gemSeries.setData(gemData);
    } catch (err) {
      console.error('[loadGemHistory]', err);
      gemSeries.setData([]);
    }
  }
  async function loadHistory(code) {
    setDataStatus('MEMUAT CHART...', 'busy');
    try {
      const result = await yahooChart(toSymbol(code));
      if (!result || result.candles.length === 0) {
        candleSeries.setData([]);
        volumeSeries.setData([]);
        vwapSeries.setData([]);
        gemSeries.setData([]);
        setDataStatus('DATA KOSONG DARI YAHOO', 'error');
        document.getElementById('lastUpdateLabel').innerText = `Tidak ada data candle untuk ${code}`;
        return;
      }

      latestCandles = cleanTimeSeries(result.candles);
      const cleanVolumes = cleanTimeSeries(result.volumes);

      candleSeries.setData(latestCandles);
      volumeSeries.setData(cleanVolumes);

      const volumeByTime = new Map(cleanVolumes.map(v => [v.time, v.value]));
      const vwapData = calcAnchoredVWAP(latestCandles, volumeByTime);
      vwapSeries.setData(vwapData);
      loadGemHistory(code);

      chart.priceScale('right').applyOptions({ autoScale: true });
      chart.timeScale().fitContent();

      const structure = calcMarketStructure(latestCandles);
      const rsi = calcRSI(latestCandles, 14);
      const lastVwap = vwapData.length ? vwapData[vwapData.length - 1].value : null;

      document.getElementById('structTrend').innerText = structure ? structure.trend : '--';
      document.getElementById('structSwingHigh').innerText = structure?.lastHigh ? fmtRp(structure.lastHigh) : '--';
      document.getElementById('structSwingLow').innerText = structure?.lastLow ? fmtRp(structure.lastLow) : '--';
      document.getElementById('structRsi').innerText = rsi != null ? rsi.toFixed(1) : '--';
      document.getElementById('structVwap').innerText = lastVwap != null ? fmtRp(Math.round(lastVwap)) : '--';

      const lastTs = latestCandles[latestCandles.length - 1].time;
      const lastCandleLabel = new Date(lastTs * 1000).toLocaleDateString('id-ID', { timeZone: 'Asia/Jakarta', day: '2-digit', month: 'short', year: 'numeric' });
      document.getElementById('lastUpdateLabel').innerText = `Candle terakhir: ${lastCandleLabel}`;

      setDataStatus('YAHOO DATA OK (delayed)', 'ok');
    } catch (err) {
      console.error('[loadHistory]', code, err);
      candleSeries.setData([]);
      volumeSeries.setData([]);
      vwapSeries.setData([]);
        gemSeries.setData([]);
      setDataStatus(`GAGAL: ${err.message}`, 'error');
    }
  }

  // ============================================================
  // LOAD QUOTE HEADER
  // ============================================================
  async function loadQuoteHeader(code) {
    try {
      const results = await yahooQuoteBatch([toSymbol(code)]);
      const q = results[0];
      if (!q) return;

      document.getElementById('activeTicker').innerText = code;
      document.getElementById('activeName').innerText = q.longName || q.shortName || '';

      const price = q.regularMarketPrice;
      const change = q.regularMarketChange;
      const changePct = q.regularMarketChangePercent;

      document.getElementById('lastPrice').innerText = fmtRp(price);
      const changeEl = document.getElementById('priceChange');
      if (change != null) {
        changeEl.innerText = `${change >= 0 ? '+' : ''}${Math.round(change).toLocaleString('id-ID')} (${fmtPct(changePct)})`;
        changeEl.className = `text-sm font-semibold ${change >= 0 ? 'text-idx-green' : 'text-idx-red'}`;
      }

      document.getElementById('bidPrice').innerText = q.bid ? fmtRp(q.bid) : '--';
      document.getElementById('bidVolume').innerText = `vol ${fmtNum(q.bidSize)}`;
      document.getElementById('offerPrice').innerText = q.ask ? fmtRp(q.ask) : '--';
      document.getElementById('offerVolume').innerText = `vol ${fmtNum(q.askSize)}`;

      if (q.fiftyTwoWeekLow != null && q.fiftyTwoWeekHigh != null && q.fiftyTwoWeekHigh > q.fiftyTwoWeekLow) {
        document.getElementById('low52Label').innerText = fmtRp(q.fiftyTwoWeekLow);
        document.getElementById('high52Label').innerText = fmtRp(q.fiftyTwoWeekHigh);
        const pct = ((price - q.fiftyTwoWeekLow) / (q.fiftyTwoWeekHigh - q.fiftyTwoWeekLow)) * 100;
        document.getElementById('range52Bar').style.width = `${Math.max(2, Math.min(100, pct))}%`;
      }
    } catch (err) {
      console.error('[loadQuoteHeader]', code, err);
    }
  }

  // ============================================================
  // LOAD MARKET OVERVIEW (IHSG & USD/IDR)
  // ============================================================
  async function loadMarketOverview() {
    try {
      const results = await yahooQuoteBatch(['^JKSE', 'IDR=X']);
      const ihsg = results.find(r => r.symbol === '^JKSE');
      const usd = results.find(r => r.symbol === 'IDR=X');

      if (ihsg) {
        const valEl = document.getElementById('ihsgValue');
        const chgEl = document.getElementById('ihsgChange');
        valEl.innerText = ihsg.regularMarketPrice ? ihsg.regularMarketPrice.toLocaleString('id-ID', { maximumFractionDigits: 2 }) : '--';
        if (ihsg.regularMarketChangePercent != null) {
          chgEl.innerText = fmtPct(ihsg.regularMarketChangePercent);
          chgEl.className = `font-semibold ${ihsg.regularMarketChangePercent >= 0 ? 'text-idx-green' : 'text-idx-red'}`;
        }
      }

      if (usd) {
        const usdEl = document.getElementById('usdIdrValue');
        usdEl.innerText = usd.regularMarketPrice ? fmtRp(Math.round(usd.regularMarketPrice)) : '--';
      }
    } catch (err) {
      console.error('[loadMarketOverview]', err);
    }
  }

  // ============================================================
  // LOAD BANDARMOLOGY
  // ============================================================
  async function loadBandarmology(code) {
    try {
      const data = await apiGet(`/api/public/summary/${encodeURIComponent(code)}`);
      if (!data.success || !data.hasData) {
        document.getElementById('bandarDateLabel').innerText = 'tidak ada data';
        return;
      }

      document.getElementById('bandarDateLabel').innerText = data.date;
      const scoreEl = document.getElementById('bandarScore');
      scoreEl.innerText = `${data.bandarScore}/100`;
      scoreEl.className = `font-bold ${data.bandarScore >= 60 ? 'text-idx-green' : data.bandarScore <= 40 ? 'text-idx-red' : 'text-idx-amber'}`;

      document.getElementById('foreignBuyToday').innerText = fmtNum(data.foreignBuyToday);
      document.getElementById('foreignSellToday').innerText = fmtNum(data.foreignSellToday);
      const netEl = document.getElementById('netForeign20d');
      netEl.innerText = `${data.netForeign20d >= 0 ? '+' : ''}${fmtNum(data.netForeign20d)}`;
      netEl.className = `font-bold ${data.netForeign20d >= 0 ? 'text-idx-green' : 'text-idx-red'}`;
    } catch (err) {
      console.error('[loadBandarmology]', code, err);
      document.getElementById('bandarDateLabel').innerText = 'gagal memuat';
    }
  }

  // ============================================================
  // WATCHLIST + MARQUEE
  // ============================================================
  async function loadWatchlist() {
    try {
      const symbols = watchlistCodes.map(toSymbol);
      const results = await yahooQuoteBatch(symbols);
      const byCode = new Map(results.map(q => [toCode(q.symbol), q]));

      const container = document.getElementById('watchlistContainer');
      container.innerHTML = '';

      if (watchlistCodes.length === 0) {
        container.innerHTML = '<div class="p-3 text-slate-500 italic">Watchlist kosong. Cari ticker di atas untuk menambah.</div>';
      }

      watchlistCodes.forEach(code => {
        const q = byCode.get(code);
        const close = q?.regularMarketPrice ?? null;
        const changePct = q?.regularMarketChangePercent ?? null;
        const name = q?.longName || q?.shortName || '';

        const row = document.createElement('div');
        row.className = `watch-row flex justify-between items-center px-3 py-2 border-b border-idx-border/50 cursor-pointer ${code === activeCode ? 'active' : ''}`;
        row.setAttribute('data-select-code', code);
        row.innerHTML = `
          <button class="watch-remove absolute left-1 top-1/2 -translate-y-1/2 w-4 h-4 flex items-center justify-center rounded text-slate-500 hover:text-idx-red hover:bg-idx-red/10 text-[10px]" title="Hapus dari watchlist" data-remove-code="${code}">
            <i class="fa-solid fa-xmark"></i>
          </button>
          <div class="pl-4">
            <div class="font-bold text-slate-100">${code}</div>
            <div class="text-[10px] text-slate-500">${name.slice(0,22)}</div>
          </div>
          <div class="text-right">
            <div class="font-semibold">${close != null ? fmtRp(close) : '--'}</div>
            <div class="text-[10px] ${changePct >= 0 ? 'text-idx-green' : 'text-idx-red'}">${changePct != null ? fmtPct(changePct) : '--'}</div>
          </div>`;
        container.appendChild(row);
      });

      const marquee = document.getElementById('marqueeTrack');
      const items = watchlistCodes.map(code => {
        const q = byCode.get(code);
        const close = q?.regularMarketPrice;
        const changePct = q?.regularMarketChangePercent;
        return `<span class="text-slate-300">${code}</span> <span class="${changePct >= 0 ? 'text-idx-green' : 'text-idx-red'}">${close != null ? fmtRp(close) : '--'} (${changePct != null ? fmtPct(changePct) : '--'})</span>`;
      }).join('<span class="text-idx-border mx-2">|</span>');
      marquee.innerHTML = items ? (items + '<span class="text-idx-border mx-2">|</span>' + items) : '<span class="text-slate-500 italic px-2">Watchlist kosong</span>';        
    } catch (err) {
      console.error('[loadWatchlist]', err);
    }
  }

  document.getElementById('watchlistContainer').addEventListener('click', (e) => {
    const removeBtn = e.target.closest('[data-remove-code]');
    if (removeBtn) {
      const code = removeBtn.getAttribute('data-remove-code');
      watchlistCodes = watchlistCodes.filter(c => c !== code);
      saveWatchlistCodesToStorage();
      if (activeCode === code) {
        if (watchlistCodes.length > 0) selectTicker(watchlistCodes[0]);
      } else {
        loadWatchlist();
      }
      return;
    }
    const row = e.target.closest('[data-select-code]');
    if (row) {
      selectTicker(row.getAttribute('data-select-code'));
    }
  });

  function selectTicker(code) {
    activeCode = code.toUpperCase();
    loadHistory(activeCode);
    loadQuoteHeader(activeCode);
    loadBandarmology(activeCode);
    loadGemScore(activeCode);
    loadWatchlist();
  }

  // ============================================================
  // SEARCH TICKER
  // ============================================================
  const searchInput = document.getElementById('tickerSearchInput');
  const searchResults = document.getElementById('searchResults');

  searchInput.addEventListener('input', async (e) => {
    const query = e.target.value.trim().toUpperCase();
    if (query.length < 2) {
      searchResults.classList.add('hidden');
      return;
    }

    try {
      const data = await apiGet(`/api/public/search?q=${encodeURIComponent(query)}`);
      const quotes = data.results || [];
      
      searchResults.innerHTML = '';
      if (!quotes.length) {
        searchResults.innerHTML = '<div class="p-3 text-slate-500 italic text-xs">Ticker tidak ditemukan</div>';
      } else {
        quotes.slice(0, 8).forEach(q => {
          const code = (q.code || "").toUpperCase();
          const item = document.createElement('div');
          item.className = 'px-3 py-2 hover:bg-idx-panel cursor-pointer flex justify-between items-center text-xs border-b border-idx-border/30';
          item.innerHTML = `
            <div>
              <span class="font-bold text-white font-mono">${code}</span>
              <span class="text-[10px] text-slate-400 ml-2">${(q.name || "").slice(0, 30)}</span>
            </div>
            <span class="text-[10px] text-idx-cyan font-mono">IDX</span>`;
          item.onclick = () => {
            if (!watchlistCodes.includes(code)) {
              watchlistCodes.push(code);
              saveWatchlistCodesToStorage();
            }
            selectTicker(code);
            searchInput.value = '';
            searchResults.classList.add('hidden');
          };
          searchResults.appendChild(item);
        });
      }
      searchResults.classList.remove('hidden');
    } catch (err) {
      console.error('[search]', err);
    }
  });

  document.addEventListener('click', (e) => {
    if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
      searchResults.classList.add('hidden');
    }
  });

  // ============================================================
  // REALTIME CLOCK & INITIALIZATION
  // ============================================================
  function updateClock() {
    const now = new Date();
    const timeStr = now.toLocaleTimeString('id-ID', { timeZone: 'Asia/Jakarta', hour12: false });
    document.getElementById('currentTime').innerText = `${timeStr} WIB`;
  }

  setInterval(updateClock, 1000);
  updateClock();

  // Initial Load
  selectTicker(activeCode);
  loadMarketOverview();

// ===== GEM Score =====
async function loadGemScore(code) {
  if (!code) return;
  const scoreEl = document.getElementById('gemScoreValue');
  const signalEl = document.getElementById('gemSignalValue');
  const volEl = document.getElementById('gemVolRatio');
  const foreignEl = document.getElementById('gemForeignNet');
  const dateEl = document.getElementById('gemDateLabel');
  if (!scoreEl) return;

  try {
    const res = await fetch('/api/gem-score/latest?codes=' + encodeURIComponent(code));
    const json = await res.json();
    if (!json.success || !json.data || !json.data.length) {
      scoreEl.textContent = '--';
      if (signalEl) signalEl.textContent = '--';
      if (volEl) volEl.textContent = '--';
      if (foreignEl) foreignEl.textContent = '--';
      if (dateEl) dateEl.textContent = '--';
      return;
    }
    const d = json.data[0];
    scoreEl.textContent = d.gem_score ?? '--';
    if (signalEl) signalEl.textContent = d.gem_signal ?? '--';
    if (volEl) volEl.textContent = d.vol_ratio ?? '--';
    if (foreignEl) foreignEl.textContent = d.foreign_net20 != null ? Number(d.foreign_net20).toLocaleString('id-ID') : '--';
    if (dateEl) dateEl.textContent = d.trade_date || '--';

    scoreEl.className = 'font-bold text-lg';
    if (signalEl) signalEl.className = 'font-bold';
    if (d.gem_score >= 75) {
      scoreEl.classList.add('text-idx-green');
      if (signalEl) signalEl.classList.add('text-idx-green');
    } else if (d.gem_score >= 60) {
      scoreEl.classList.add('text-idx-cyan');
      if (signalEl) signalEl.classList.add('text-idx-cyan');
    } else if (d.gem_score >= 45) {
      scoreEl.classList.add('text-idx-amber');
      if (signalEl) signalEl.classList.add('text-idx-amber');
    } else {
      scoreEl.classList.add('text-slate-400');
      if (signalEl) signalEl.classList.add('text-slate-400');
    }
  } catch (err) {
    console.error('[GEM]', err);
  }
}
