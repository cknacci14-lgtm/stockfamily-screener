  function repairMojibakeString(value) {

    let current = String(value ?? "");

    for (let i = 0; i < 3; i++) {

      if (!/[ÃÂâð]/.test(current)) {
        break;
      }

      try {

        const bytes =
          Uint8Array.from(
            Array.from(current).map(
              (char) =>
                char.charCodeAt(0) & 0xff
            )
          );

        const decoded =
          new TextDecoder("utf-8", {
            fatal: true,
          }).decode(bytes);

        if (
          decoded === current ||
          decoded.includes("�")
        ) {
          break;
        }

        current = decoded;

      } catch {
        break;
      }
    }

    return current;
  }

  function repairMojibake(root) {

    if (!root) return;

    const walker =
      document.createTreeWalker(
        root,
        NodeFilter.SHOW_TEXT
      );

    const nodes = [];

    while (walker.nextNode()) {
      nodes.push(walker.currentNode);
    }

    for (const node of nodes) {

      const fixed =
        repairMojibakeString(
          node.nodeValue
        );

      if (
        fixed &&
        fixed !== node.nodeValue
      ) {
        node.nodeValue = fixed;
      }
    }

    // Repair selected attributes as well.
    const elements =
      root.querySelectorAll
        ? root.querySelectorAll(
            "[title],[aria-label]"
          )
        : [];

    for (const el of elements) {

      for (
        const attr of [
          "title",
          "aria-label",
        ]
      ) {

        if (!el.hasAttribute(attr)) {
          continue;
        }

        const original =
          el.getAttribute(attr);

        const fixed =
          repairMojibakeString(
            original
          );

        if (fixed !== original) {
          el.setAttribute(
            attr,
            fixed
          );
        }
      }
    }
  }

