  function scoreExistingSidebar(el) {

    const text =
      (
        el.innerText ||
        el.textContent ||
        ""
      )
        .replace(/\s+/g, " ")
        .trim()
        .toLowerCase();

    const matches =
      NAV_ITEMS.filter(
        (item) =>
          text.includes(
            item.label.toLowerCase()
          )
      ).length;

    const rect =
      el.getBoundingClientRect();

    let score =
      matches * 10;

    if (matches >= 3) {
      score += 20;
    }

    if (rect.left < 40) {
      score += 8;
    }

    if (
      rect.width >= 180 &&
      rect.width <= 380
    ) {
      score += 6;
    }

    if (
      rect.height >
      window.innerHeight * .55
    ) {
      score += 5;
    }

    return {
      el,
      score,
      matches,
    };
  }

  function findExistingSidebar() {

    const candidates =
      [
        ...document.querySelectorAll(
          "aside, nav, [role='navigation'], [class*='sidebar' i]"
        ),
      ]
        .map(scoreExistingSidebar)
        .filter(
          (x) => x.matches >= 3
        )
        .sort(
          (a,b) =>
            b.score - a.score
        );

    return candidates.length
      ? candidates[0].el
      : null;
  }

  function wrapExistingLabels(sidebar) {

    const links =
      sidebar.querySelectorAll("a");

    links.forEach((link) => {

      const walker =
        document.createTreeWalker(
          link,
          NodeFilter.SHOW_TEXT
        );

      const nodes = [];

      while (walker.nextNode()) {
        const node =
          walker.currentNode;

        if (
          !node.nodeValue.trim()
        ) {
          continue;
        }

        if (
          node.parentElement?.closest(
            ".sf-sidebar-label, script, style"
          )
        ) {
          continue;
        }

        nodes.push(node);
      }

      nodes.forEach((node) => {

        const text =
          node.nodeValue;

        if (
          node.parentElement?.classList
            ?.contains("sf-sidebar-label")
        ) {
          return;
        }

        const clean =
          repairMojibakeString(
            text
          ).trim();

        if (!clean) return;

        const span =
          document.createElement(
            "span"
          );

        span.className =
          "sf-sidebar-label";

        span.textContent =
          clean;

        node.parentNode.replaceChild(
          span,
          node
        );
      });
    });
  }

  function createToggle(sidebar) {

    if (
      sidebar.querySelector(
