  function toggle(sidebar) {

    const collapsed =
      document.documentElement
        .classList
        .contains(
          "sf-sidebar-collapsed"
        );

    const next =
      !collapsed;

    document.documentElement
      .classList
      .toggle(
        "sf-sidebar-collapsed",
        next
      );

    localStorage.setItem(
      STORAGE_KEY,
      String(next)
    );

    updateMobileState();
  }

  function updateMobileState() {

    const collapsed =
      document.documentElement
        .classList
        .contains(
          "sf-sidebar-collapsed"
        );

    const backdrop =
      document.getElementById(
        "sf-mobile-backdrop"
      );

    if (!backdrop) return;

    if (
      window.innerWidth <= 768 &&
      !collapsed
    ) {
      backdrop.style.display =
        "block";
    } else {
      backdrop.style.display =
        "none";
    }
  }

  function createMobileControls() {

    if (
      document.getElementById(
        "sf-mobile-toggle"
      )
    ) {
      return;
    }

    const backdrop =
      document.createElement(
        "div"
      );

    backdrop.id =
      "sf-mobile-backdrop";

    backdrop.addEventListener(
      "click",
      () => {

        document.documentElement
          .classList.add(
            "sf-sidebar-collapsed"
          );

        localStorage.setItem(
          STORAGE_KEY,
          "true"
        );

        updateMobileState();
      }
    );

    document.body.appendChild(
      backdrop
    );

    const button =
      document.createElement(
        "button"
      );

    button.id =
      "sf-mobile-toggle";

    button.type = "button";

    button.setAttribute(
      "aria-label",
      "Open StockFamily navigation"
    );

    button.innerHTML = `
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>
    `;

    button.addEventListener(
      "click",
      () => {

        document.documentElement
          .classList.remove(
            "sf-sidebar-collapsed"
          );

        localStorage.setItem(
          STORAGE_KEY,
          "false"
        );

        updateMobileState();
      }
    );

    document.body.appendChild(
      button
    );
  }

  function setupTransitions(root) {

    root
      .querySelectorAll("a[href]")
      .forEach((link) => {

        if (
          link.dataset.sfTransitionBound
        ) {
          return;
        }

        link.dataset.sfTransitionBound =
          "true";

        link.addEventListener(
          "click",
          (event) => {

            if (
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey ||
              link.target === "_blank"
            ) {
              return;
            }

            const href =
              link.getAttribute(
                "href"
              );

            if (
              !href ||
              href.startsWith("#") ||
              href.startsWith(
                "javascript:"
              )
            ) {
              return;
            }

            let next;

            try {
              next =
                new URL(
                  href,
                  window.location.href
                );
            } catch {
              return;
            }

            if (
              next.origin !==
              window.location.origin
            ) {
              return;
            }

            event.preventDefault();

            document.body.style.opacity =
              ".72";

            document.body.style.transition =
              "opacity .12s ease";

            window.setTimeout(
              () => {
                window.location.href =
                  next.href;
              },
              80
            );
          }
        );
      });
  }

  function applySavedState() {

    const saved =
      localStorage.getItem(
        STORAGE_KEY
      );

    const collapsed =
      saved === null
        ? false
        : saved === "true";

    document.documentElement
      .classList
      .toggle(
        "sf-sidebar-collapsed",
        collapsed
      );
  }

  function init() {

    injectCSS();

    repairMojibake(
      document.body
    );

    const existing =
      findExistingSidebar();

    if (existing) {

      existing.classList.add(
        "sf-existing-sidebar"
      );

      wrapExistingLabels(
        existing
      );

      activeExistingSidebar(
        existing
      );

      createToggle(
        existing
      );

      setupTransitions(
        existing
      );

    } else {

      const fallback =
        createFallbackSidebar();

      document.body.classList.add(
        "sf-fallback-active"
      );

      setupTransitions(
        fallback
      );
    }

    createMobileControls();

    applySavedState();

    updateMobileState();

    window.addEventListener(
      "resize",
      updateMobileState
    );

    // Repair dynamically inserted mojibake.
    const observer =
      new MutationObserver(
        (mutations) => {

          for (
            const mutation of mutations
          ) {

            if (
              mutation.type !==
              "childList"
            ) {
              continue;
            }

            for (
              const node of mutation.addedNodes
            ) {

              if (
                node.nodeType ===
                Node.TEXT_NODE
              ) {

                node.nodeValue =
                  repairMojibakeString(
                    node.nodeValue
                  );

              } else if (
                node.nodeType ===
                Node.ELEMENT_NODE
              ) {

                repairMojibake(
                  node
                );
              }
            }
          }
        }
      );

    observer.observe(
      document.body,
      {
        childList: true,
        subtree: true,
      }
    );

    document.documentElement
      .classList
      .add(
        "sf-sidebar-ready"
      );
  }

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      init,
      { once: true }
    );
  } else {
    init();
  }

})();
