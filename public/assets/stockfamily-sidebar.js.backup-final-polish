      );

    button.type = "button";
    button.className =
      "sf-toggle";

    button.setAttribute(
      "aria-label",
      "Toggle sidebar"
    );

    button.innerHTML = `
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m14 6-6 6 6 6"></path>
      </svg>
    `;

    button.addEventListener(
      "click",
      (event) => {
        event.preventDefault();
        event.stopPropagation();
        toggle(sidebar);
      }
    );

    sidebar.appendChild(button);
  }

  function activeExistingSidebar(sidebar) {

    const current =
      pageKey();

    sidebar
      .querySelectorAll("a[href]")
      .forEach((link) => {

        const href =
          link.getAttribute("href");

        if (!href) return;

        let path = "";

        try {
          path =
            new URL(
              href,
              window.location.href
            ).pathname
              .replace(
                /\\/g,
                "/"
              )
              .toLowerCase();
        } catch {
          return;
        }

        const item =
          NAV_ITEMS.find(
            (nav) => {

              const navPath =
                new URL(
                  nav.href,
                  window.location.href
                ).pathname
                  .replace(
                    /\\/g,
                    "/"
                  )
                  .toLowerCase();

              return (
                navPath === path
              );
            }
          );

        if (
          item?.key === current
        ) {
          link.classList.add(
            "sf-active"
          );
        }
      });
  }

